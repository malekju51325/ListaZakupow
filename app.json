{
  "expo": {
    "name": "Lista zakupów",
    "slug": "lista-zakupow",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/app-icon.png",
    "scheme": "listazakupow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.justynamalek.listazakupow"
    },
    "android": {
      "package": "com.justynamalek.listazakupow",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F7",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F7",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 160,
          "android": {
            "image": "./assets/images/app-icon.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "636c688a-1245-40c8-a971-a12994b858e9"
      }
    },
    "owner": "justynamaleks-organization"
  }
}
